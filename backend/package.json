{
  "name": "@lumora/backend",
  "private": true,
  "version": "0.1.0",
  "description": "Lumora API server.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "worker": "tsx watch --clear-screen=false src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:status": "tsx src/db/migrate.ts status",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:auth": "vitest run --project integration tests/integration/auth-",
    "test:coverage": "vitest run --coverage",
    "reindex": "tsx scripts/reindex.ts",
    "eval:seed": "tsx eval/seed.ts",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@lumora/shared": "*",
    "argon2": "^0.44.0",
    "chromadb": "^3.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "file-type": "^21.3.4",
    "helmet": "^8.1.0",
    "jose": "^6.2.8",
    "kysely": "^0.28.9",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
