# Lumora API — environment
#
# Copy to `.env` and adjust. Every variable here is validated by Zod at boot
# (src/config/env.ts); the process refuses to start if any is missing or
# malformed, and prints which one.
#
# This file lists exactly what the current milestone reads. Provider
# configuration (LLM, embeddings, vector store, storage, mail) is documented in
# docs/03-backend.md §5 and is added to the schema by the milestone that first
# reads it — validating a key nothing can use only teaches people to ignore a
# failed boot.

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

PORT=4000
# 127.0.0.1 keeps the port off the local network in development. Containers
# need 0.0.0.0, or the port publishes to nothing.
HOST=127.0.0.1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated absolute origins. No wildcard: the API sends credentials, and
# browsers reject `*` with credentials anyway.
#
# Both dev ports are listed because both are real: `npm run dev` starts Vite on
# its default 5173, while .claude/launch.json pins 5273 for the in-editor
# preview. Listing only one produces a CORS rejection that looks like a server
# bug and is actually a port mismatch.
CORS_ORIGINS=http://localhost:5173,http://localhost:5273

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://lumora:lumora@localhost:5432/lumora

# Per-process share of Postgres' `max_connections` (100 by default), not a
# target. Leave headroom for migrations and a psql session.
DATABASE_POOL_MAX=10

# ── Application ──────────────────────────────────────────────────────────────
# Where the frontend lives. Only used to build the links inside emails, so a
# wrong value here produces verification links that 404 rather than a boot
# failure — which is why it is validated as a URL rather than trusted.
APP_URL=http://localhost:5173

# ── Authentication ───────────────────────────────────────────────────────────
# Minimum 32 characters. In production the schema additionally refuses anything
# containing "change-me", "example", or "placeholder": a deployment signing
# tokens with the value from this file is indistinguishable from one with no
# secret at all.
#
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-0000000000000000000000000000

# Seconds. Short by design — an access token cannot be revoked individually, so
# its lifetime IS the revocation window (docs/04-data-and-api.md §3.1).
JWT_ACCESS_TTL_SECONDS=900

# Days. The refresh token is revocable, so it can afford to be long-lived.
REFRESH_TOKEN_TTL_DAYS=30

# Checks new passwords against Have I Been Pwned's k-anonymity range API. The
# password never leaves this process — only the first five characters of its
# SHA-1. Fails open if HIBP is unreachable.
PASSWORD_BREACH_CHECK=true

# ── Mail ─────────────────────────────────────────────────────────────────────
# `console` writes the message to the log instead of sending it. SMTP arrives
# with real delivery.
MAIL_DRIVER=console
MAIL_FROM=Lumora <no-reply@lumora.app>

# ── Logging ──────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
# Omit to default: debug in development, info everywhere else.
# LOG_LEVEL=debug
