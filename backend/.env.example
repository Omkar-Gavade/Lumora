# Lumora API — environment
#
# Copy to `.env` and adjust. Every variable here is validated by Zod at boot
# (src/config/env.ts); the process refuses to start if any is missing or
# malformed, and prints which one.
#
# This file lists exactly what the current milestone reads. Provider
# configuration (LLM, embeddings, vector store, storage, mail) is documented in
# docs/03-backend.md §5 and is added to the schema by the milestone that first
# reads it — validating a key nothing can use only teaches people to ignore a
# failed boot.

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

PORT=4000
# 127.0.0.1 keeps the port off the local network in development. Containers
# need 0.0.0.0, or the port publishes to nothing.
HOST=127.0.0.1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated absolute origins. No wildcard: the API sends credentials, and
# browsers reject `*` with credentials anyway.
#
# Both dev ports are listed because both are real: `npm run dev` starts Vite on
# its default 5173, while .claude/launch.json pins 5273 for the in-editor
# preview. Listing only one produces a CORS rejection that looks like a server
# bug and is actually a port mismatch.
CORS_ORIGINS=http://localhost:5173,http://localhost:5273

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://lumora:lumora@localhost:5432/lumora

# Per-process share of Postgres' `max_connections` (100 by default), not a
# target. Leave headroom for migrations and a psql session.
DATABASE_POOL_MAX=10

# ── Application ──────────────────────────────────────────────────────────────
# Where the frontend lives. Only used to build the links inside emails, so a
# wrong value here produces verification links that 404 rather than a boot
# failure — which is why it is validated as a URL rather than trusted.
APP_URL=http://localhost:5173

# ── Authentication ───────────────────────────────────────────────────────────
# Minimum 32 characters. In production the schema additionally refuses anything
# containing "change-me", "example", or "placeholder": a deployment signing
# tokens with the value from this file is indistinguishable from one with no
# secret at all.
#
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-0000000000000000000000000000

# Seconds. Short by design — an access token cannot be revoked individually, so
# its lifetime IS the revocation window (docs/04-data-and-api.md §3.1).
JWT_ACCESS_TTL_SECONDS=900

# Days. The refresh token is revocable, so it can afford to be long-lived.
REFRESH_TOKEN_TTL_DAYS=30

# Checks new passwords against Have I Been Pwned's k-anonymity range API. The
# password never leaves this process — only the first five characters of its
# SHA-1. Fails open if HIBP is unreachable.
PASSWORD_BREACH_CHECK=true

# ── Mail ─────────────────────────────────────────────────────────────────────
# console | smtp
#
# `console` writes the message to the log instead of sending it — the default,
# and the right choice for local work: no credentials, no rate limits, and the
# verification link is right there in the terminal.
#
# `smtp` delivers for real. The SMTP_* variables below are then REQUIRED and
# the process refuses to start without them.
MAIL_DRIVER=console

# The envelope sender. For Gmail this MUST be the authenticated account —
# Google silently rewrites a mismatched From, which breaks DKIM alignment and
# sends the mail to spam.
MAIL_FROM=Lumora <no-reply@lumora.app>

# ── SMTP (only read when MAIL_DRIVER=smtp) ───────────────────────────────────
# Gmail. See backend/README.md for the App Password walkthrough.
#
# 587 + SMTP_SECURE=false is STARTTLS; 465 + SMTP_SECURE=true is implicit TLS.
# The two must agree — a mismatch hangs until the socket timeout instead of
# failing, so the schema rejects it at boot.
#
# Either way the connection is encrypted: with SMTP_SECURE=false the transport
# sets `requireTLS`, so it refuses to send if STARTTLS is unavailable rather
# than falling back to cleartext.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com

# NEVER your Google account password. Create a 16-character App Password:
# https://myaccount.google.com/apppasswords  (needs 2-Step Verification on).
# Spaces in the generated value are cosmetic and may be removed.
# SMTP_PASSWORD=

# Milliseconds. Three separate timeouts because they fail at three different
# points — no TCP connection, a connection that never greeted, or a greeting
# followed by silence — and the log needs to say which.
# SMTP_CONNECTION_TIMEOUT=10000
# SMTP_GREETING_TIMEOUT=10000
# SMTP_SOCKET_TIMEOUT=10000

# ── Logging ──────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
# Omit to default: debug in development, info everywhere else.
# LOG_LEVEL=debug

# ── Worker ───────────────────────────────────────────────────────────────────
# Runs the ingestion worker inside the API process. Set to false and run
# `npm run worker` to give it its own process — nothing in the worker depends
# on being co-located, so the split is a deployment decision.
# WORKER_ENABLED=true

# Jobs one worker runs at once. Parsing is memory-bound, not I/O-bound: a
# 25 MB PDF holds its page tree, fonts, and text at once, and over-parallelising
# gets the worker OOM-killed.
# WORKER_CONCURRENCY=2

# Gap between polls when the queue came back empty. A latency knob, not a load
# one — a backlog drains at full speed regardless, because the loop polls again
# immediately after a successful claim.
# WORKER_POLL_INTERVAL_MS=1000

# How long a claim survives without a heartbeat before the reaper takes it back.
# This bounds crash recovery: a killed worker strands its documents for at most
# this long. It can be short because running jobs heartbeat.
# WORKER_LEASE_MS=60000

# Lease renewal cadence. Must be well under WORKER_LEASE_MS — the schema
# rejects a value that is not, because a slow heartbeat means the reaper steals
# jobs from workers that are alive and working.
# WORKER_HEARTBEAT_INTERVAL_MS=15000

# How often to sweep for expired leases. Every worker sweeps; there is no
# leader election, because the sweep is one idempotent UPDATE.
# WORKER_REAPER_INTERVAL_MS=30000
