# Lumora API — test environment
#
# Copy to `.env.test`. Read only by the Vitest suite, via
# `tests/setup/env.ts`, which maps these onto the names `src/config/env.ts`
# validates.
#
# The TEST_ prefix is a safety property, not a naming convention. Without it a
# `DATABASE_URL` exported in your shell — or set in CI for a deploy step — is
# silently inherited, and the first `TRUNCATE users CASCADE` runs against real
# data. The suite refuses to fall back to DATABASE_URL, and refuses to run at
# all unless the target database name ends in `_test`.

# Must end in `_test`. Created automatically by the global setup if absent.
TEST_DATABASE_URL=postgresql://lumora:lumora@localhost:5432/lumora_test

# Any 32+ character value. Tokens signed here never leave the test process.
TEST_JWT_ACCESS_SECRET=test-only-jwt-secret-000000000000000000

# `console` never opens a socket. Integration tests additionally replace the
# provider with an in-memory fake so the outbox can be asserted on.
TEST_MAIL_DRIVER=console

# `silent` keeps pino out of the test output. Raise to `debug` when a failure
# needs the request log.
TEST_LOG_LEVEL=silent

TEST_APP_URL=http://localhost:5173
TEST_CORS_ORIGINS=http://localhost:5173
