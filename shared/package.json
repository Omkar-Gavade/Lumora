{
  "name": "@lumora/shared",
  "private": true,
  "version": "0.1.0",
  "description": "Contract shared by the Lumora backend and frontend: error codes, API types, Zod schemas.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "zod": "^4.4.3"
  }
}
